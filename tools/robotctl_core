HERE = Path(__file__).resolve().parent
DEFAULT_CONFIG = Path("~/.config/parkingbot/production_hosts.env").expanduser()


def repo_root(config=None):
    """저장소 루트를 찾는다.

    ``install_robot_commands.sh`` 는 이 스크립트를 ``~/.local/bin`` 으로
    복사한다. 그러면 ``HERE.parent`` 는 ``~/.local`` 이 되어 소스 대조가
    항상 "source missing" 으로 실패한다. 설치본에서도 동작하도록 실제
    저장소를 찾는다.
    """
    override = os.environ.get("PARKINGBOT_REPO")
    if override:
        return Path(override).expanduser()
    candidates = []
    if config and config.get("CONTROL_WORKSPACE"):
        candidates.append(Path(config["CONTROL_WORKSPACE"]).expanduser())
    candidates.extend((Path.cwd(), HERE.parent,
                       Path("~/parkingbot_active").expanduser(),
                       Path("~/parkingbot").expanduser()))
    for candidate in candidates:
        if (candidate / "ros2" / "cooperative_parking_robot").is_dir():
            return candidate.resolve()
    # 못 찾으면 예전 동작을 유지한다. 오류 메시지가 경로를 알려준다.
    return HERE.parent


def deployed_repository(config, role):
    """Return the source repository used for a role's runtime install."""
    return role_workspace(config, role)


def config_path(args):
    return Path(args.config or os.environ.get("PARKINGBOT_CONFIG", DEFAULT_CONFIG)).expanduser()


def checked_config(args):
    try:
        config = load_env(config_path(args))
    except ValueError as exc:
        print(f"[BLOCKED] {exc}", file=sys.stderr)
        raise SystemExit(2)
    missing = missing_config(config)
    if missing:
        for key in missing:
            print(f"[BLOCKED] {key} is not configured", file=sys.stderr)
        raise SystemExit(2)
    bad_paths = invalid_paths(config)
    if bad_paths:
        for key in bad_paths:
            print(f"[BLOCKED] {key} must be an absolute path", file=sys.stderr)
        raise SystemExit(2)
    conditional = conditional_config_errors(config)
    if conditional:
        for reason in conditional:
            print(f"[BLOCKED] {reason}", file=sys.stderr)
        raise SystemExit(2)
    return config


def reachable(runner, config, role):
    result = remote_run(runner, role_host(config, role), "true", timeout=7)
    return result.returncode == 0


def session_exists(runner, config, role):
    result = remote_run(
        runner, role_host(config, role), f"tmux has-session -t {SESSION}", timeout=7)
    return result.returncode == 0


def process_status(runner, config, role):
    status = stack_process_status(runner, role_host(config, role))
    status.update({
        "role": role,
        "launch_command": launch_command(config, role),
    })
    return status


def startup_process_failure(processes):
    for role in ROLES:
        status = processes.get(role, {})
        if status.get("state") in ("EXITED", "SESSION_MISSING"):
            return role, status
    return None


def tool_installation_warnings(repository):
    """Report copied command files that no longer match an available checkout."""
    repository_tools = Path(repository) / "tools"
    if HERE == repository_tools or not repository_tools.is_dir():
        return []
    warnings = []
    for name in ("robotctl", "robotctl_core", "parkingbot_ops.py",
                 "parkingbot_ros_snapshot.py"):
        installed = HERE / name
        source = repository_tools / name
        if source.is_file() and installed.is_file():
            if source.read_bytes() != installed.read_bytes():
                warnings.append(f"installed tool differs from repository: {name}")
    return warnings


def manifest(config, role, launch):
    workspace = role_workspace(config, role)
    return (
        "date --iso-8601=seconds; hostname; "
        f"printf 'revision='; {workspace_revision_command(workspace)}; "
        f"printf 'ROS_DOMAIN_ID=%s\\nRMW_IMPLEMENTATION=%s\\nlaunch=%s\\nworkspace=%s\\n' "
        f"{shlex.quote(config['ROS_DOMAIN_ID'])} {shlex.quote(config['RMW_IMPLEMENTATION'])} "
        f"{shlex.quote(launch)} {shlex.quote(workspace)}")


def stack_launch_command(prefix, launch, remote_dir, log_name):
    """Create a detached pane whose real exit code remains inspectable."""
    log_path = f"{remote_dir}/{log_name}"
    pane_body = (
        "set -o pipefail; "
        f"printf '%s\\n' \"$$\" > {remote_dir}/stack_shell.pid; "
        f"({prefix} && {launch}) 2>&1 | tee -a {log_path}; "
        "rc=${PIPESTATUS[0]}; "
        f"printf 'returncode=%s\\nfinished_at=%s\\n' \"$rc\" "
        f"\"$(date --iso-8601=seconds)\" > {remote_dir}/stack_exit.env; "
        "exit \"$rc\"")
    pane_command = "bash -lc " + shlex.quote(pane_body)
    target = SESSION + ":stack.0"
    return (
        f"tmux new-session -d -s {SESSION} -n stack && "
        f"tmux set-option -w -t {target} remain-on-exit on && "
        f"tmux respawn-pane -k -t {target} {shlex.quote(pane_command)} && "
        f"tmux display-message -p -t {target} '#{{pane_pid}}' > "
        f"{remote_dir}/stack_pane.pid")


def startup_conditions(data):
    values = data["topics"]
    return {
        "Fleet manager": isinstance(values["fleet"], dict),
        "Front state_machine": values["front_state"] is not None,
        "Rear state_machine": values["rear_state"] is not None,
        "cctv_merge": values["merge"] is not None,
        "Rear ID0 camera/tracker": values["id0_marker"] is not None,
        "Front hardware_ready": (
            values["front_hw"] is True and values["front_state"] == "IDLE"),
        "Rear hardware_ready": (
            values["rear_hw"] is True and values["rear_state"] == "IDLE"),
    }


def startup_fatal_faults(data):
    values = data["topics"]
    faults = []
    for role in ("front", "rear"):
        state = values[f"{role}_state"]
        status = values[f"{role}_hw_status"]
        if state == "FAULT":
            faults.append(
                f"{role.upper()} hardware_ready=false "
                f"({status or 'robot_state=FAULT'})")
        elif isinstance(status, str) and status.startswith(("ERR,", "ESTOP")):
            faults.append(
                f"{role.upper()} hardware_ready=false ({status})")
    return faults


def report_startup_progress(data, previous):
    conditions = startup_conditions(data)
    values = data["topics"]
    current = {}
    for label, ok in conditions.items():
        if ok:
            rendered = "OK"
        elif label.endswith("hardware_ready"):
            role = label.split()[0].lower()
            status = values[f"{role}_hw_status"]
            rendered = f"WAIT:{status}" if status else "WAIT"
        else:
            rendered = "WAIT"
        current[label] = rendered
        if previous.get(label) != rendered:
            prefix = "OK" if rendered == "OK" else "WAIT"
            detail = ""
            if rendered.startswith("WAIT:"):
                detail = f" ({rendered.removeprefix('WAIT:')})"
            print(f"[{prefix}] {label}{detail}", flush=True)
    return current, conditions


def print_observer_failure(observer):
    print(f"[OBSERVER FAIL] {observer['message']}")
    detail = observer.get("observer_stderr") or observer.get("observer_stdout")
    if detail:
        print("  " + detail.replace("\n", "\n  "))


STAGE_FRESH_MS = 2500.0
STAGE_TIMEOUT_S = {"jetson": 60.0, "rear": 60.0, "front": 75.0}
STAGE_STABLE_S = {"jetson": 3.0, "rear": 3.0, "front": 5.0}


def _fresh(data, key, limit_ms=STAGE_FRESH_MS):
    age = data.get("topic_ages_ms", {}).get(key)
    return age is not None and 0.0 <= float(age) <= limit_ms


def _counter_baseline(data, role):
    diag = data.get("topics", {}).get(f"{role}_hb")
    if not isinstance(diag, dict):
        return None
    return {
        "ack_count": int(diag.get("ack_count", 0)),
        "velocity_tx_count": int(diag.get("velocity_tx_count", 0)),
        "velocity_deadline_miss_count": int(
            diag.get("velocity_deadline_miss_count", 0)),
        "uart_write_failure_count": int(
            diag.get("uart_write_failure_count", 0)),
    }


def machine_stage_conditions(role, data, process, baseline=None):
    """Current-value stage gates; lifetime maxima are intentionally ignored."""
    values = data.get("topics", {})
    running = process.get("state") == "RUNNING"
    if role == "jetson":
        fleet = values.get("fleet")
        merge = values.get("merge")
        cameras = merge.get("cameras", {}) if isinstance(merge, dict) else {}
        return {
            "Jetson process alive": running,
            "fleet/state fresh": isinstance(fleet, dict) and _fresh(data, "fleet"),
            "CCTV merge fresh": isinstance(merge, dict) and _fresh(data, "merge"),
            "cam0 fresh": bool(cameras.get("cam0", {}).get("alive")),
            "cam2 fresh": bool(cameras.get("cam2", {}).get("alive")),
            "parking map fresh": bool(values.get("map_stream")) and _fresh(
                data, "map_stream"),
        }

    diag = values.get(f"{role}_hb")
    status = values.get(f"{role}_hw_status")
    fault = values.get(f"{role}_fault")
    state = values.get(f"{role}_state")
    diag_ok = isinstance(diag, dict) and _fresh(data, f"{role}_hb")
    fatal = (state == "FAULT" or
             isinstance(status, str) and status.startswith(("ERR,", "ESTOP")) or
             fault not in (None, "", "OK", "-"))
    conditions = {
        f"{role.title()} process alive": running,
        f"{role.title()} robot_state fresh": _fresh(data, f"{role}_state"),
        f"{role.title()} startup-safe state": state == "IDLE",
        f"{role.title()} hardware_ready": (
            values.get(f"{role}_hw") is True and _fresh(data, f"{role}_hw")),
        f"{role.title()} odom fresh": (
            bool(values.get(f"{role}_odom")) and _fresh(data, f"{role}_odom")),
        f"{role.title()} diagnostics fresh": diag_ok,
        f"{role.title()} communication stable": (
            diag_ok and not bool(diag.get("recovering", True))),
        f"{role.title()} no fatal fault": not fatal,
    }
    if baseline is None or not diag_ok:
        conditions[f"{role.title()} counter baseline"] = False
        return conditions
    conditions[f"{role.title()} no new UART write failure"] = (
        int(diag.get("uart_write_failure_count", 0)) ==
        baseline["uart_write_failure_count"])
    if role == "front":
        conditions.update({
            "Front heartbeat ACK progressing": (
                int(diag.get("ack_count", 0)) > baseline["ack_count"]),
            "Front heartbeat recent": (
                diag.get("last_heartbeat_ack_age_ms") is not None and
                float(diag["last_heartbeat_ack_age_ms"]) < 400.0),
            "Front command TX progressing": (
                int(diag.get("velocity_tx_count", 0)) >
                baseline["velocity_tx_count"]),
            "Front no new command deadline miss": (
                int(diag.get("velocity_deadline_miss_count", 0)) ==
                baseline["velocity_deadline_miss_count"]),
        })
    return conditions


def wait_machine_stage(role, config, observer_samples, runner, processes,
                       *, clock=time.monotonic):
    """Require continuous readiness without sleeping or recreating DDS."""
    timeout_s = float(config.get(
        f"{role.upper()}_STAGE_TIMEOUT_S", STAGE_TIMEOUT_S[role]))
    stable_s = float(config.get(
        f"{role.upper()}_STAGE_STABLE_S", STAGE_STABLE_S[role]))
    if timeout_s <= 0.0 or stable_s <= 0.0 or stable_s >= timeout_s:
        print(f"[{role.upper()} STARTUP FAILED] invalid stage timing")
        return False, None, {"valid stage timing": False}
    deadline = clock() + timeout_s
    stable_since = None
    baseline = None
    previous = {}
    last_conditions = {}
    for observer in observer_samples:
        now = clock()
        current = process_status(runner, config, role)
        processes[role] = current
        data = snapshot(config, observer_result=observer)
        data["processes"] = dict(processes)
        if role != "jetson" and baseline is None:
            baseline = _counter_baseline(data, role)
        conditions = machine_stage_conditions(
            role, data, current, baseline)
        last_conditions = conditions
        for label, ok in conditions.items():
            rendered = "OK" if ok else "WAIT"
            if previous.get(label) != rendered:
                print(f"[{rendered}] {label}", flush=True)
        previous = {label: ("OK" if ok else "WAIT")
                    for label, ok in conditions.items()}
        if conditions and all(conditions.values()):
            if stable_since is None:
                stable_since = now
            if now - stable_since >= stable_s:
                print(f"[{role.upper()} STAGE OK] stable {stable_s:.1f}s")
                return True, data, conditions
        else:
            stable_since = None
        if now >= deadline:
            break
    print(f"[{role.upper()} STARTUP FAILED]")
    for label, ok in last_conditions.items():
        if not ok:
            print(f"[FAIL] {label}")
    return False, None, last_conditions


def incident_metadata(role, reason, data, process=None, config=None):
    values = data.get("topics", {})
    process = process or {}
    return {
        "role": role,
        "reason": reason,
        "pid": process.get("pid"),
        "process_state": process.get("state"),
        "process_alive": process.get("process_alive"),
        "returncode": process.get("returncode"),
        "probe_returncode": process.get("probe_returncode"),
        "hardware_ready": values.get(f"{role}_hw") if role else None,
        "robot_state": values.get(f"{role}_state") if role else None,
        "motion_fault": values.get(f"{role}_fault") if role else None,
        "timestamp": data.get("timestamp"),
        "launch_command": (
            process.get("launch_command") or
            (launch_command(config, role) if config and role else None)),
    }


def launch_machine(args, config, runner, role, run_id, head, processes):
    """Start one machine exactly once; readiness is checked by the caller."""
    remote_head = remote_run(
        runner, role_host(config, role),
        workspace_revision_command(role_workspace(config, role)),
        timeout=7).stdout.strip()
    if remote_head and head and remote_head != head:
        print(
            f"[WARN] {role.title()} code revision differs\n"
            f"  Controller: {head}\n  {role.title()}: {remote_head}")
    launch = launch_command(config, role)
    log_name = ("cctv_server_dual.log" if role == "jetson"
                else f"{role}_robot.log")
    remote_dir = f"$HOME/.ros/parkingbot_logs/{run_id}/{role}"
    command = (
        f"mkdir -p {remote_dir} $HOME/.ros/parkingbot_logs/"
        f"{run_id}/incidents && "
        f"ln -sfn {run_id} $HOME/.ros/parkingbot_logs/latest && "
        f"({manifest(config, role, launch)}) > {remote_dir}/run_manifest.txt && "
        + stack_launch_command(
            ros_prefix(config, role), launch, remote_dir, log_name))
    print(f"[START] {role.title()} production stack")
    result = remote_run(runner, role_host(config, role), command, timeout=12)
    if result.returncode:
        print(
            f"[FAIL] {role.title()} start: "
            f"{(result.stderr or result.stdout).strip()}")
        return False
    status = process_status(runner, config, role)
    processes[role] = status
    if status["state"] != "RUNNING":
        print(
            f"[FAIL] {role.title()} stack did not stay alive: "
            f"{status['state']} returncode={status.get('returncode')}")
        return False
    print(f"[PROCESS OK] {role.title()} stack pid={status['pid']}")
    if (role == "rear" and
            config["REAR_ENABLE_INTERNAL_CAMERA"].lower() == "false"):
        camera_log = (
            f"$HOME/.ros/parkingbot_logs/{run_id}/rear/rear_camera.log")
        camera_command = (
            ros_prefix(config, "rear") + " && " +
            config["REAR_EXTERNAL_CAMERA_COMMAND"] +
            f" 2>&1 | tee -a {camera_log}")
        result = remote_run(
            runner, role_host(config, "rear"),
            f"tmux new-window -t {SESSION} -n rear-camera "
            f"{shlex.quote(camera_command)}", timeout=10)
        if result.returncode:
            print("[FAIL] Rear external camera start")
            return False
    return True


def wait_final_readiness(config, observer_samples, runner, processes,
                         *, clock=time.monotonic):
    """Preserve the existing whole-system distributed readiness contract."""
    started_at = clock()
    grace_until = started_at + 3.0
    deadline = started_at + 120.0
    previous = {}
    conditions = {}
    data = None
    for observer in observer_samples:
        now = clock()
        for role in ROLES:
            processes[role] = process_status(runner, config, role)
        process_failure = startup_process_failure(processes)
        if process_failure:
            role, current = process_failure
            print(
                f"[PROCESS EXITED] {role.title()} stack "
                f"state={current['state']} exit={current.get('returncode')}")
            return False, None, conditions
        data = snapshot(config, observer_result=observer)
        data["processes"] = dict(processes)
        previous, conditions = report_startup_progress(data, previous)
        fatal = startup_fatal_faults(data)
        if fatal and now >= grace_until:
            for reason in fatal:
                print(f"[FAIL] {reason}")
            return False, data, conditions
        if conditions and all(conditions.values()):
            return True, data, conditions
        if now >= deadline:
            break
    return False, data, conditions


def run_machine_stages(launch_one, wait_one):
    """Launch the next machine only after the prior stable gate passes."""
    for role in ROLES:
        if not launch_one(role):
            return False, role, "launch"
        if not wait_one(role):
            return False, role, "readiness"
    return True, None, None


def start(args):
    config = checked_config(args)
    runner = Runner()
    print("ParkingBot Production Start\n===========================\n")
    prerequisite_errors = observer_prerequisite_errors(config, runner=runner)
    if prerequisite_errors:
        for error in prerequisite_errors:
            print(f"[OBSERVER FAIL] {error}")
        return 1
    print(
        f"[OBSERVER OK] local ROS prerequisites "
        f"({config.get('OBSERVER_PYTHON', '/usr/bin/python3')})")
    for warning in tool_installation_warnings(repo_root(config)):
        print(f"[WARN] {warning}; rerun tools/install_robot_commands.sh")
    protocol_errors = protocol_consistency_errors(repo_root(config))
    if protocol_errors:
        for error in protocol_errors:
            print(f"[FAIL] protocol consistency: {error}")
        return 1
    if shutil.which("tmux") is None:
        print("[FAIL] tmux is not installed on the control machine")
        return 1
    for role in ROLES:
        if not reachable(runner, config, role):
            print(f"[FAIL] {role.title()} host unreachable")
            return 1
        print(f"[OK] {role.title()} reachable")
    running = [role for role in ROLES if session_exists(runner, config, role)]
    if running:
        print("\nProduction stack is already running.")
        print("Use: robot_state | robot_restart | robot_stop")
        return 2
    # Check every deployment before starting the first process. A mixed
    # firmware/bridge release fails without disrupting any running stack.
    for role in ROLES:
        remote_repository = deployed_repository(config, role)
        protocol_check = remote_run(
            runner, role_host(config, role),
            protocol_source_check_command(remote_repository), timeout=7)
        if protocol_check.returncode:
            print(
                f"[FAIL] {role.title()} firmware/ROS protocol capability "
                "mismatch")
            return 1
        ownership_check = remote_run(
            runner, role_host(config, role),
            runtime_ownership_check_command(config, role), timeout=25)
        if ownership_check.returncode:
            detail = (ownership_check.stdout or ownership_check.stderr).strip()
            print(
                f"[FAIL] {role.title()} runtime escapes selected workspace"
                + (f"\n{detail}" if detail else ""))
            return 1
    run_dir = create_run_dir()
    run_id = run_dir.name
    processes = {}
    head = subprocess.run(
        ["git", "-C", str(repo_root(config)), "rev-parse", "HEAD"],
        text=True, capture_output=True).stdout.strip()
    observer_samples = persistent_observer_samples(
        config, mode="full", interval=0.5)
    try:
        def launch_one(role):
            return launch_machine(
                args, config, runner, role, run_id, head, processes)

        def wait_one(role):
            stage_ok, _, _ = wait_machine_stage(
                role, config, observer_samples, runner, processes)
            if not stage_ok:
                print(
                    f"{role.title()} stage failed; later machines were not "
                    "started. Started processes remain available for logs.")
            return stage_ok

        staged_ok, failed_role, failure_phase = run_machine_stages(
            launch_one, wait_one)
        if not staged_ok:
            if failure_phase == "launch":
                stop_sessions(runner, config, publish_estop=False)
            return 1
        (run_dir / "run_manifest.txt").write_text(
            f"run_id={run_id}\ncontroller_commit={head}\n"
            f"config={config_path(args)}\n")
        (run_dir / "state" / "processes.json").write_text(
            json.dumps(processes, indent=2, ensure_ascii=False) + "\n")
        print("\nWaiting for final whole-system ROS readiness...")
        final_ok, data, conditions = wait_final_readiness(
            config, observer_samples, runner, processes)
    except (RuntimeError, OSError) as exc:
        print(f"[OBSERVER FAIL] {exc}")
        return 1
    finally:
        observer_samples.close()
    if data is None:
        print("[OBSERVER FAIL] final readiness received no data")
        return 1
    if not final_ok or not conditions or not all(conditions.values()):
        for label, ok in conditions.items():
            if not ok:
                print(f"[FAIL] {label}")
        reason = "STARTUP_READINESS_TIMEOUT"
        incident_snapshot(
            run_dir, reason, data, config, runner,
            incident_metadata(None, reason, data))
        print("Startup graph incomplete; processes remain available for robot_logs.")
        return 1
    if automatic_state_monitor_enabled(config):
        print("[START] State/log monitor (explicitly enabled)")
        monitor_cmd = (
            f"{shlex.quote(str(Path(__file__).resolve()))} --config "
            f"{shlex.quote(str(config_path(args)))} monitor")
        subprocess.run([
            "tmux", "new-session", "-d", "-s", SESSION + "-monitor",
            monitor_cmd], check=False)
    else:
        print(
            "[SKIP] automatic DDS state monitor disabled; "
            "use the existing operator UI during motion")
    print("\nSystem started. Safety readiness remains visible in robot_state.")
    print("Run:\n  robot_state\n  robot_logs\n  robot_stop")
    return 0


def stop_sessions(runner, config, publish_estop=True):
    if publish_estop:
        command = (ros_prefix(config, "jetson") +
                   " && timeout 3 ros2 topic pub --once /emergency_stop std_msgs/msg/Bool '{data: true}'")
        remote_run(runner, role_host(config, "jetson"), command, timeout=7)
    for role in ("front", "rear", "jetson"):
        print(f"[STOP] {role.title()}")
        remote_run(runner, role_host(config, role), f"tmux kill-session -t {SESSION}", timeout=7)
    subprocess.run(["tmux", "kill-session", "-t", SESSION + "-monitor"], capture_output=True)


def stop(args):
    config = checked_config(args)
    # STM32 는 ESTOP 을 전원 재인가까지 latch 한다. 곧바로 다시 띄울 때는
    # latch 를 남기면 새 세션이 시작하자마자 FAULT 로 떨어져 복구가 안 된다.
    stop_sessions(Runner(), config,
                  publish_estop=not getattr(args, "no_estop", False))
    print("[OK] Production stack stopped")
    print("Safety/STM32 ESTOP latches are not reset; MANUAL RESET MAY BE REQUIRED.")
    return 0


def restart(args):
    args.no_estop = True
    code = stop(args)
    return code or start(args)


def state(args):
    config = checked_config(args)
    hosts = {}
    runner = Runner()
    hosts = {role: ("ONLINE" if reachable(runner, config, role) else "OFFLINE") for role in ROLES}
    if args.watch:
        try:
            for observer in persistent_observer_samples(
                    config, mode="full", interval=1.0):
                data = snapshot(
                    config, hosts=hosts, observer_result=observer)
                output = (json.dumps(data, ensure_ascii=False, indent=2)
                          if args.json else format_snapshot(data))
                if not args.json:
                    print("\033[2J\033[H", end="")
                print(output, flush=True)
        except KeyboardInterrupt:
            return 130
        return 1
    else:
        data = snapshot(config, hosts=hosts)
        output = json.dumps(data, ensure_ascii=False, indent=2) if args.json else format_snapshot(data)
        print(output, flush=True)
        return 0 if not data["blockers"] else 1


def persistent_observer_samples(config, *, mode, interval):
    """Yield updates from exactly one long-lived rclpy/DDS participant."""
    command = observer_argv(config, [
        config.get("OBSERVER_PYTHON", "/usr/bin/python3"),
        str(observer_helper_path()), "--mode", mode, "--timeout", "86400",
        "--stream-interval", str(float(interval)),
    ])
    process = subprocess.Popen(
        command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        bufsize=1)
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    last_observer = {
        "observer_ok": True, "topics": {}, "ages_ms": {},
        "complete": False,
    }
    last_received_at = time.monotonic()
    try:
        while True:
            events = selector.select(timeout=1.0)
            if events:
                line = process.stdout.readline()
                if line:
                    observer = parse_observer_output(line)
                    if not observer["observer_ok"]:
                        raise RuntimeError(observer["message"])
                    last_observer = observer
                    last_received_at = time.monotonic()
                    yield observer
                    continue
            if process.poll() is not None:
                stderr = process.stderr.read()
                raise RuntimeError(
                    f"persistent observer exited rc={process.returncode}: "
                    f"{stderr.strip()}")
            elapsed_ms = (time.monotonic() - last_received_at) * 1000.0
            stale = dict(last_observer)
            stale["ages_ms"] = {
                key: float(age) + elapsed_ms
                for key, age in last_observer.get("ages_ms", {}).items()
            }
            yield stale
    finally:
        selector.close()
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


def logs(args):
    root = run_root()
    latest = root / "latest"
    if not latest.exists():
        print("[BLOCKED] no production run logs found", file=sys.stderr)
        return 2
    target = latest.resolve()
    print(f"Run: {target}")
    roles = ROLES if args.component == "all" else (args.component,)
    if args.follow and config_path(args).exists() and args.component != "sync":
        config = load_env(config_path(args))
        processes = []
        try:
            for role in roles:
                name = ("cctv_server_dual.log" if role == "jetson"
                        else f"{role}_robot.log")
                remote_path = f"$HOME/.ros/parkingbot_logs/{target.name}/{role}/{name}"
                command = (
                    f"tail -n {max(1, args.lines)} -F {remote_path} | "
                    f"sed -u 's/^/[{role.upper()}] /'")
                processes.append(subprocess.Popen(remote_argv(
                    role_host(config, role), command)))
            return max(process.wait() for process in processes)
        except KeyboardInterrupt:
            for process in processes:
                process.terminate()
            return 130
    paths = []
    for role in roles:
        if role == "sync":
            path = target / "state" / "state_monitor.jsonl"
            name = path.name
        else:
            name = "cctv_server_dual.log" if role == "jetson" else f"{role}_robot.log"
            path = target / role / name
        paths.append(path)
        print(f"\n===== {role.upper()} =====")
        if path.exists():
            lines = path.read_text(errors="replace").splitlines()
            selected = lines[-args.lines:]
            print("\n".join(selected))
        elif role != "sync" and config_path(args).exists():
            config = load_env(config_path(args))
            remote_path = f"$HOME/.ros/parkingbot_logs/{target.name}/{role}/{name}"
            result = remote_run(
                Runner(), role_host(config, role),
                f"grep -Ei 'error|warn|fault|fatal|timeout|lost|reject' {remote_path} | tail -n 20; "
                f"echo '--- RECENT ---'; tail -n {max(1, args.lines)} {remote_path}", timeout=8)
            print(result.stdout if result.returncode == 0 else
                  "remote log unavailable")
        else:
            print("log unavailable")
    incidents = sorted((target / "incidents").glob("*"))
    print(f"\nIncidents: {len(incidents)}" + (f" (latest {incidents[-1]})" if incidents else ""))
    if args.follow:
        existing = [str(path) for path in paths if path.exists()]
        if existing:
            return subprocess.run(["tail", "-F", *existing]).returncode
        print("[BLOCKED] no local logs available to follow", file=sys.stderr)
        return 2
    return 0


def doctor(args):
    config = checked_config(args)
    runner = Runner()
    blockers = []
    blockers.extend(
        f"control observer: {error}"
        for error in observer_prerequisite_errors(config, runner=runner))
    blockers.extend(
        f"control tooling: {warning}"
        for warning in tool_installation_warnings(repo_root(config)))
    blockers.extend(
        f"control: protocol consistency: {error}"
        for error in protocol_consistency_errors(repo_root(config)))
    if shutil.which("tmux") is None:
        blockers.append("control: tmux missing")
    if not Path(config["ROS_SETUP"]).is_file():
        blockers.append("control: ROS setup missing")
    if not Path(config["CONTROL_WORKSPACE"], "install/setup.bash").is_file():
        blockers.append("control: workspace install missing")
    for role in ROLES:
        if not reachable(runner, config, role):
            blockers.append(f"{role} host unreachable")
            continue
        workspace = role_workspace(config, role)
        checks = [
            ("command -v tmux >/dev/null", "tmux missing"),
            (f"test -f {shlex.quote(config['ROS_SETUP'])}", "ROS setup missing"),
            (f"test -f {shlex.quote(workspace + '/install/setup.bash')}", "workspace install missing"),
            (package_source_check_command(
                workspace, ('cctv_server_dual.launch.py' if role == 'jetson'
                            else role + '_robot.launch.py')),
             "launch file missing"),
            (runtime_ownership_check_command(config, role),
             "runtime import/prefix escapes selected workspace"),
            ("test \"$(timedatectl show -p NTPSynchronized --value 2>/dev/null)\" = yes", "clock not NTP synchronized"),
            (protocol_source_check_command(
                workspace),
             "firmware/ROS protocol capability mismatch"),
        ]
        if role == "jetson":
            checks.extend((
                (f"test -e {shlex.quote(config['CAM0_DEVICE'])}", "CCTV0 device missing"),
                (f"test -e {shlex.quote(config['CAM2_DEVICE'])}", "CCTV2 device missing"),
                (f"test -f {shlex.quote(config['MODEL_PATH'])}", "vehicle model missing"),
                ("test -f $HOME/.ros/adaptive_valet_bot/parking_layout.yaml", "runtime layout missing"),
                ("test -f $HOME/.ros/adaptive_valet_bot/homography_cam0_rectified.npy", "CAM0 homography missing"),
                ("test -f $HOME/.ros/adaptive_valet_bot/homography_cam2_rectified.npy", "CAM2 homography missing"),
            ))
        else:
            checks.append((f"test -e {shlex.quote(config[role.upper() + '_SERIAL'])}", "STM32 serial missing"))
            if role == "rear":
                checks.append((f"test -f {shlex.quote(config['REAR_CALIB'])}", "Rear calibration missing"))
                if config["REAR_ENABLE_INTERNAL_CAMERA"].lower() == "true":
                    checks.append((
                        f"test -e {shlex.quote(config['REAR_CAMERA_DEVICE'])}",
                        "Rear camera device missing on Rear host"))
        for command, reason in checks:
            result = remote_run(runner, role_host(config, role), command, timeout=25)
            if result.returncode:
                blockers.append(f"{role}: {reason}")
    print("READY" if not blockers else "BLOCKED")
    for item in blockers:
        print(f"- {item}")
    return 0 if not blockers else 1


def monitor(args):
    config = checked_config(args)
    root = run_root()
    latest = root / "latest"
    if not latest.exists():
        return 2
    run_dir = latest.resolve()
    runner = Runner()
    last_faults = set()
    grace_until = time.monotonic() + 15.0
    restart_count = 0
    backoff_s = 1.0
    while True:
        try:
            for observer in persistent_observer_samples(
                    config, mode="full", interval=2.0):
                data = snapshot(config, observer_result=observer)
                processes = {
                    role: process_status(runner, config, role) for role in ROLES}
                data["processes"] = processes
                with (run_dir / "state" / "state_monitor.jsonl").open("a") as stream:
                    stream.write(json.dumps(data, ensure_ascii=False) + "\n")
                faults = set(data["blockers"])
                process_incidents = {}
                for role, status in processes.items():
                    # Only EXITED is authoritative; observer failures do not
                    # become robot safety incidents.
                    if status["state"] == "EXITED":
                        reason = f"{role.upper()} PROCESS EXITED"
                        faults.add(reason)
                        process_incidents[reason] = (role, status)
                for reason in sorted(faults - last_faults):
                    if (time.monotonic() >= grace_until and any(
                            word in reason for word in
                            ("FAULT", "SYNC:", "HARDWARE", "PROCESS EXITED"))):
                        if reason in process_incidents:
                            role, status = process_incidents[reason]
                        elif reason.startswith("FRONT"):
                            role, status = "front", processes["front"]
                        elif reason.startswith("REAR"):
                            role, status = "rear", processes["rear"]
                        else:
                            role, status = None, None
                        target = incident_snapshot(
                            run_dir, reason, data, config, runner,
                            incident_metadata(
                                role, reason, data, status, config))
                        for log_role in ROLES:
                            name = ("cctv_server_dual.log"
                                    if log_role == "jetson"
                                    else f"{log_role}_robot.log")
                            remote_path = (
                                f"$HOME/.ros/parkingbot_logs/{run_dir.name}/"
                                f"{log_role}/{name}")
                            result = remote_run(
                                runner, role_host(config, log_role),
                                f"tail -n 200 {remote_path}", timeout=8)
                            (target / f"{log_role}_tail.log").write_text(
                                result.stdout + result.stderr)
                last_faults = (
                    faults if time.monotonic() >= grace_until else set())
            return 0
        except (RuntimeError, OSError) as exc:
            restart_count += 1
            with (run_dir / "state" / "state_monitor.jsonl").open("a") as stream:
                stream.write(json.dumps({
                    "observer_error": str(exc),
                    "observer_restart_count": restart_count,
                    "timestamp": time.time(),
                }, ensure_ascii=False) + "\n")
            if restart_count >= 5:
                return 1
            time.sleep(backoff_s)
            backoff_s = min(30.0, backoff_s * 2.0)


def main():
    parser = argparse.ArgumentParser(prog="robotctl")
    parser.add_argument("--config")
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("start", "restart", "doctor", "monitor"):
        sub.add_parser(name)
    stop_parser = sub.add_parser("stop")
    stop_parser.add_argument(
        "--no-estop", action="store_true",
        help="ESTOP latch 를 남기지 않고 세션만 내린다 (바로 재시작할 때)")
    state_parser = sub.add_parser("state")
    state_parser.add_argument("-w", "--watch", action="store_true")
    state_parser.add_argument("--json", action="store_true")
    logs_parser = sub.add_parser("logs")
    logs_parser.add_argument("component", nargs="?", choices=("all", *ROLES, "sync"), default="all")
    logs_parser.add_argument("-f", "--follow", action="store_true")
    logs_parser.add_argument("-n", "--lines", type=int, default=80)
    argv = sys.argv[1:]
    invoked = Path(sys.argv[0]).name
    if invoked.startswith("robot_") and invoked != "robotctl":
        argv.insert(0, invoked.removeprefix("robot_"))
    args = parser.parse_args(argv)
    if args.command == "restart":
        return restart(args)
    return globals()[args.command](args)


if __name__ == "__main__":
    raise SystemExit(main())
