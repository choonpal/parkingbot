# Installer copies this to ~/.config/parkingbot/production_hosts.env.
# Use absolute workspace/asset/device paths; shell ~/$HOME expansion is not
# accepted because commands execute on three different remote home directories.
# Robot SSH uses mDNS names so DHCP address changes do not affect operations.
JETSON_HOST=
FRONT_HOST=robot@robot-2.local
REAR_HOST=robot@robot-1.local
JETSON_WORKSPACE=
FRONT_WORKSPACE=
REAR_WORKSPACE=
# Colcon workspace installed on the laptop/control machine.
CONTROL_WORKSPACE=

# Shared ROS deployment environment.
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_SETUP=/opt/ros/humble/setup.bash
# Absolute ROS-compatible Python used by the local diagnostic observer.
OBSERVER_PYTHON=/usr/bin/python3

# Jetson site measurements/assets from REAL_ROBOT_DEPLOYMENT_RUNBOOK.md.
CAM0_DEVICE=
CAM2_DEVICE=
MODEL_PATH=
CAM0_GROUND_X_M=
CAM0_GROUND_Y_M=
CAM0_HEIGHT_M=
CAM2_GROUND_X_M=
CAM2_GROUND_Y_M=
CAM2_HEIGHT_M=
FRONT_MARKER_HEIGHT_M=
REAR_MARKER_HEIGHT_M=

# Shared measured vehicle/robot values.
WHEELBASE=
FRONT_SERIAL=
FRONT_WHEEL_RADIUS=
FRONT_ENCODER_PPR=
FRONT_LX=
FRONT_LY=
FRONT_LEFT_SENSOR_X=
FRONT_RIGHT_SENSOR_X=
REAR_SERIAL=
REAR_WHEEL_RADIUS=
REAR_ENCODER_PPR=
REAR_LX=
REAR_LY=
REAR_LEFT_SENSOR_X=
REAR_RIGHT_SENSOR_X=
REAR_CALIB=

# Runbook production default: external driver publishes this topic.
REAR_CAMERA_TOPIC=/rear/marker_camera/image
REAR_ENABLE_INTERNAL_CAMERA=false
# If internal=true, prefer the verified persistent by-id path. The numeric
# index is a fallback only. If false, provide the exact existing site
# camera-driver command; robotctl starts it in a second tmux window.
REAR_CAMERA_DEVICE=
REAR_CAMERA_ID=
REAR_EXTERNAL_CAMERA_COMMAND=
COMMAND_SOURCE_TIMEOUT_S=0.25
# PySerial write deadline only; STM32 command/heartbeat watchdogs remain
# fixed at 0.25/0.30 seconds. Site ST-LINK VCP latency may require up to 0.10.
SERIAL_WRITE_TIMEOUT_S=0.05
# Entry-only commissioning mode. true prevents LIFT ready/commit after axle
# alignment and exposes /front|rear/aligned_hold for verification.
STOP_AFTER_ALIGN=false
